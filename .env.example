# Razorpay API credentials. Test mode only — this project never needs live keys.
#
# Dashboard > toggle "Test Mode" (top bar) > Account & Settings > API Keys >
# Generate Test Key. The secret is shown exactly once, so copy it immediately.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Shared secret you choose when registering the webhook under
# Account & Settings > Webhooks. Used to verify the X-Razorpay-Signature
# header; requests failing verification are rejected before any state change.
RAZORPAY_WEBHOOK_SECRET=

# "mock" runs the deterministic in-process gateway and needs no credentials.
# "live" talks to Razorpay test mode using the keys above.
RECOUP_GATEWAY=mock

# Optional. Powers only the ambiguous tail of the diagnosis layer; the
# taxonomy path is deterministic and works with this unset.
ANTHROPIC_API_KEY=

# Seed for the synthetic generator. Pinned so the reported batch numbers
# reproduce exactly.
RECOUP_SEED=20260821
